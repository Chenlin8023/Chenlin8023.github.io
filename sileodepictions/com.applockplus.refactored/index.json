          "text": "17.2.1"
        },
        {
          "class": "DepictionTableTextView",
          "title": "越狱形态",
          "text": "RootHide（按应用注入，免 substrate）"
        },
        {
          "class": "DepictionTableTextView",
          "title": "验证状态",
          "text": "已验证"
        },
        {
          "class": "DepictionSubheaderView",
          "title": "注意事项",
          "useBoldText": true,
          "useBottomMargin": true
        },
        {
          "class": "DepictionMarkdownView",
          "markdown": "- 载体包：dylib 位于 /var/mobile/Documents/AppLockPlus/，用 Debs 导出或 Filza 取出，再由 TrollFools / JailFools 注入目标 App。\n- 不要过 RootHide 转换器；本包是免 substrate 的按应用注入 dylib。\n- 构建目标 iOS 14+；实机验证为 iPhone 15 Pro / iOS 17.2.1。"
        }
      ]
    },
